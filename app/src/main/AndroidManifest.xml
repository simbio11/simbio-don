<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 창밖 날씨만 받아온다 (Open-Meteo, 고른 도시 좌표만 보냄). 가계부 기록·알림 내용은 보내지 않는다 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 매일 밤 지출 알림 (설정에서 켤 때만 묻는다) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 폰 캘린더 연동 (켤 때만 묻는다. 일정은 이 폰 안에서만 읽고 쓴다) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 설치 여부를 확인할 기본 결제 앱 (Android 11+ 패키지 가시성). 목록은 core DefaultApps와 같게 유지 -->
    <queries>
        <package android:name="com.samsung.android.spay" />
        <package android:name="viva.republica.toss" />
        <package android:name="com.kakaopay.app" />
        <package android:name="com.kakao.bank" />
        <package android:name="com.shcard.smartpay" />
        <package android:name="com.kbcard.cxh.appcard" />
        <package android:name="com.hyundaicard.appcard" />
        <package android:name="kr.co.samsungcard.mpocket" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.google.android.apps.messaging" />
        <!-- 첫 설정에서 알림을 읽을 앱을 고를 때 설치된 앱 목록 (실행 아이콘이 있는 앱만) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Don">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 쇼핑 앱에서 "공유 → 돈't" → 모의 쇼핑 -->
            <intent-filter android:label="모의로 사기">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".notify.PaymentListenerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 홈 화면 위젯: 이번 주 남은 돈 -->
        <receiver
            android:name=".widget.WeekWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>

        <!-- 위젯: 무지출 잔디 (깃허브 잔디처럼) -->
        <receiver
            android:name=".widget.GrassWidget"
            android:exported="false"
            android:label="@string/widget_grass_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_grass_info" />
        </receiver>

        <!-- 위젯: 이번 달 달력 -->
        <receiver
            android:name=".widget.CalendarWidget"
            android:exported="false"
            android:label="@string/widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>

        <!-- 위젯: 모은 돈 -->
        <receiver
            android:name=".widget.SavedWidget"
            android:exported="false"
            android:label="@string/widget_saved_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_saved_info" />
        </receiver>

        <!-- 위젯: 내 캐릭터 -->
        <receiver
            android:name=".widget.BuddyWidget"
            android:exported="false"
            android:label="@string/widget_buddy_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_buddy_info" />
        </receiver>

        <receiver
            android:name=".notify.DailyReminder$Receiver"
            android:exported="false" />
        <receiver
            android:name=".notify.DailyReminder$BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
